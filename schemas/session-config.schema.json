{
  "$defs": {
    "ActivityConfig": {
      "additionalProperties": false,
      "description": "Pre-ASR activity and bleed-gate parameters.",
      "properties": {
        "bleed": {
          "$ref": "#/$defs/BleedConfig"
        },
        "correlation_max_lag_ms": {
          "default": 30,
          "exclusiveMinimum": 0,
          "maximum": 1000,
          "title": "Correlation Max Lag Ms",
          "type": "integer"
        },
        "scoring": {
          "$ref": "#/$defs/ScoringConfig"
        },
        "vad": {
          "$ref": "#/$defs/VadConfig"
        }
      },
      "title": "ActivityConfig",
      "type": "object"
    },
    "AsrConfig": {
      "additionalProperties": false,
      "description": "Model identity and inference parameters. Every field affects output.",
      "properties": {
        "aligner": {
          "default": "Qwen/Qwen3-ForcedAligner-0.6B",
          "minLength": 1,
          "title": "Aligner",
          "type": "string"
        },
        "aligner_revision": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Aligner Revision"
        },
        "context_file": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": "glossary.txt",
          "title": "Context File"
        },
        "device": {
          "default": "auto",
          "enum": [
            "auto",
            "cpu",
            "cuda"
          ],
          "title": "Device",
          "type": "string"
        },
        "dtype": {
          "default": "auto",
          "enum": [
            "auto",
            "float32",
            "bfloat16"
          ],
          "title": "Dtype",
          "type": "string"
        },
        "max_new_tokens": {
          "default": 1024,
          "exclusiveMinimum": 0,
          "title": "Max New Tokens",
          "type": "integer"
        },
        "max_segment_s": {
          "default": 120,
          "exclusiveMinimum": 0,
          "maximum": 120,
          "title": "Max Segment S",
          "type": "integer"
        },
        "model": {
          "default": "Qwen/Qwen3-ASR-1.7B",
          "minLength": 1,
          "title": "Model",
          "type": "string"
        },
        "model_revision": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Revision"
        },
        "truncation_margin_tokens": {
          "default": 16,
          "maximum": 512,
          "minimum": 0,
          "title": "Truncation Margin Tokens",
          "type": "integer"
        }
      },
      "title": "AsrConfig",
      "type": "object"
    },
    "BleedConfig": {
      "additionalProperties": false,
      "description": "When one track's candidate is really another track's voice (ADR-0014).\n\nSuppression requires all three of a score margin, a correlation, and a level below the\nveto. Any one of them failing keeps the candidate, because losing real overlapped\nspeech is worse than spending more ASR compute.",
      "properties": {
        "correlation_window_ms": {
          "default": 2000,
          "exclusiveMinimum": 0,
          "maximum": 30000,
          "title": "Correlation Window Ms",
          "type": "integer"
        },
        "min_attributed_reference_candidates": {
          "default": 1,
          "maximum": 100,
          "minimum": 1,
          "title": "Min Attributed Reference Candidates",
          "type": "integer"
        },
        "min_correlation": {
          "default": 0.5,
          "exclusiveMinimum": 0.0,
          "maximum": 1.0,
          "title": "Min Correlation",
          "type": "number"
        },
        "min_reference_candidates": {
          "default": 3,
          "maximum": 100,
          "minimum": 1,
          "title": "Min Reference Candidates",
          "type": "integer"
        },
        "min_score_margin": {
          "default": 0.15,
          "exclusiveMinimum": 0.0,
          "maximum": 1.0,
          "title": "Min Score Margin",
          "type": "number"
        },
        "veto_db": {
          "default": 12.0,
          "exclusiveMinimum": 0.0,
          "maximum": 60.0,
          "title": "Veto Db",
          "type": "number"
        }
      },
      "title": "BleedConfig",
      "type": "object"
    },
    "DuplicateConfig": {
      "additionalProperties": false,
      "description": "When two tracks' segments are the same utterance heard twice (spec, Milestone 3).\n\nCollapse needs **all three** of substantial temporal overlap, strongly similar normalized\ntext, and supporting acoustic evidence — and the acoustic half comes from the activity\ngraph's own per-pair measurements rather than from a second correlator (ADR-0017).\n\nThe thresholds split by what settles them. The text ones are calibrated against *Qwen's*\nerror distribution — how differently one model transcribes the same utterance heard on two\nlavs (OQ-018). The acoustic ones are about a real room, which is OQ-017's question.",
      "properties": {
        "min_correlation": {
          "default": 0.5,
          "exclusiveMinimum": 0.0,
          "maximum": 1.0,
          "title": "Min Correlation",
          "type": "number"
        },
        "min_overlap_ratio": {
          "default": 0.5,
          "exclusiveMinimum": 0.0,
          "maximum": 1.0,
          "title": "Min Overlap Ratio",
          "type": "number"
        },
        "min_score_margin": {
          "default": 0.1,
          "exclusiveMinimum": 0.0,
          "maximum": 1.0,
          "title": "Min Score Margin",
          "type": "number"
        },
        "min_text_chars": {
          "default": 12,
          "maximum": 1000,
          "minimum": 1,
          "title": "Min Text Chars",
          "type": "integer"
        },
        "min_text_similarity": {
          "default": 0.85,
          "exclusiveMinimum": 0.0,
          "maximum": 1.0,
          "title": "Min Text Similarity",
          "type": "number"
        },
        "min_text_words": {
          "default": 4,
          "maximum": 100,
          "minimum": 1,
          "title": "Min Text Words",
          "type": "integer"
        }
      },
      "title": "DuplicateConfig",
      "type": "object"
    },
    "EncodeConfig": {
      "additionalProperties": false,
      "description": "Everything after the render boundary: what the MP3 must measure, and what to do if it\ndoes not (ADR-0023).\n\nNone of this enters the render cache identity. The intermediate is written at unity master\ngain, so changing a target or a tolerance re-encodes rather than re-mixing six tracks.",
      "properties": {
        "duration_tolerance_frames": {
          "default": 1,
          "maximum": 100,
          "minimum": 0,
          "title": "Duration Tolerance Frames",
          "type": "integer"
        },
        "loudness_tolerance_lu": {
          "default": 1.0,
          "exclusiveMinimum": 0.0,
          "maximum": 10.0,
          "title": "Loudness Tolerance Lu",
          "type": "number"
        },
        "max_master_gain_db": {
          "default": 30.0,
          "exclusiveMinimum": 0.0,
          "maximum": 60.0,
          "title": "Max Master Gain Db",
          "type": "number"
        },
        "max_retries": {
          "default": 3,
          "maximum": 16,
          "minimum": 0,
          "title": "Max Retries",
          "type": "integer"
        },
        "silence_floor_lufs": {
          "default": -50.0,
          "maximum": 0.0,
          "minimum": -70.0,
          "title": "Silence Floor Lufs",
          "type": "number"
        },
        "true_peak_tolerance_db": {
          "default": 0.3,
          "exclusiveMinimum": 0.0,
          "maximum": 6.0,
          "title": "True Peak Tolerance Db",
          "type": "number"
        }
      },
      "title": "EncodeConfig",
      "type": "object"
    },
    "EnvelopeConfig": {
      "additionalProperties": false,
      "description": "How the activity graph becomes a gain per track per moment (ADR-0022).\n\nEverything here changes the samples in the mix, so this whole section — and only this\nsection — enters the render cache identity. The encode settings beside it reach the MP3,\nwhich is regenerated on every run and never cached (ADR-0023).\n\nEvery default is a number chosen against 10.5 seconds of shaped noise. **OQ-019** is the\nrecord of that.",
      "properties": {
        "attack_ms": {
          "default": 10,
          "exclusiveMinimum": 0,
          "maximum": 1000,
          "title": "Attack Ms",
          "type": "integer"
        },
        "control_rate_hz": {
          "default": 1000,
          "exclusiveMinimum": 0,
          "maximum": 48000,
          "title": "Control Rate Hz",
          "type": "integer"
        },
        "max_level_correction_db": {
          "default": 6.0,
          "maximum": 24.0,
          "minimum": 0.0,
          "title": "Max Level Correction Db",
          "type": "number"
        },
        "min_active_share": {
          "default": 0.5,
          "exclusiveMinimum": 0.0,
          "maximum": 1.0,
          "title": "Min Active Share",
          "type": "number"
        },
        "overlap_min_gain_db": {
          "default": -16.0,
          "exclusiveMaximum": 0.0,
          "minimum": -60.0,
          "title": "Overlap Min Gain Db",
          "type": "number"
        },
        "release_ms": {
          "default": 300,
          "exclusiveMinimum": 0,
          "maximum": 10000,
          "title": "Release Ms",
          "type": "integer"
        },
        "room_tone_share": {
          "default": 0.005,
          "exclusiveMaximum": 1.0,
          "exclusiveMinimum": 0.0,
          "title": "Room Tone Share",
          "type": "number"
        },
        "solo_attenuation_margin_db": {
          "default": 20.0,
          "exclusiveMinimum": 0.0,
          "maximum": 120.0,
          "title": "Solo Attenuation Margin Db",
          "type": "number"
        }
      },
      "title": "EnvelopeConfig",
      "type": "object"
    },
    "MixConfig": {
      "additionalProperties": false,
      "description": "Automix and encode targets.\n\nThe three fields the spec's own `session.yaml` names stay at this level; the rest is split\nby which side of the render boundary it falls on (ADR-0023).",
      "properties": {
        "encode": {
          "$ref": "#/$defs/EncodeConfig"
        },
        "envelope": {
          "$ref": "#/$defs/EnvelopeConfig"
        },
        "integrated_lufs": {
          "default": -16.0,
          "maximum": 0.0,
          "minimum": -70.0,
          "title": "Integrated Lufs",
          "type": "number"
        },
        "mp3_bitrate_kbps": {
          "default": 128,
          "title": "Mp3 Bitrate Kbps",
          "type": "integer"
        },
        "true_peak_dbtp": {
          "default": -1.5,
          "maximum": 0.0,
          "minimum": -20.0,
          "title": "True Peak Dbtp",
          "type": "number"
        }
      },
      "title": "MixConfig",
      "type": "object"
    },
    "RecoveryConfig": {
      "additionalProperties": false,
      "description": "Escape hatches, all of them off by default and all of them recorded.",
      "properties": {
        "allow_processed_audio": {
          "default": false,
          "title": "Allow Processed Audio",
          "type": "boolean"
        },
        "source_time_overrides": {
          "additionalProperties": {
            "$ref": "#/$defs/SourceTimeOverride"
          },
          "title": "Source Time Overrides",
          "type": "object"
        }
      },
      "title": "RecoveryConfig",
      "type": "object"
    },
    "ScoringConfig": {
      "additionalProperties": false,
      "description": "How four pieces of evidence become one source score.\n\nWeights are relative and normalized by their sum, so doubling all four changes\nnothing. The spans are the dynamic ranges each term is mapped over; a term is clamped\nat both ends rather than allowed to dominate the total from one outlier.",
      "properties": {
        "confidence_weight": {
          "default": 0.25,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence Weight",
          "type": "number"
        },
        "correlation_weight": {
          "default": 0.15,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Correlation Weight",
          "type": "number"
        },
        "dominance_span_db": {
          "default": 20.0,
          "exclusiveMinimum": 0.0,
          "maximum": 120.0,
          "title": "Dominance Span Db",
          "type": "number"
        },
        "dominance_weight": {
          "default": 0.25,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Dominance Weight",
          "type": "number"
        },
        "level_span_db": {
          "default": 30.0,
          "exclusiveMinimum": 0.0,
          "maximum": 120.0,
          "title": "Level Span Db",
          "type": "number"
        },
        "level_weight": {
          "default": 0.35,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Level Weight",
          "type": "number"
        }
      },
      "title": "ScoringConfig",
      "type": "object"
    },
    "SourceTimeOverride": {
      "additionalProperties": false,
      "description": "Exceptional replacement timing for one source file.\n\nExists because file presence cannot recover missing timing metadata, and INV-12\nforbids inventing it. An override supplies evidence from outside the file — a field\nlog — and says so in ``reason``, which is required so the manifest and report can\nshow why a time was not read from the source.",
      "properties": {
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "recording_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Recording Date"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "start_offset_samples": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start Offset Samples"
        },
        "start_timecode": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start Timecode"
        }
      },
      "required": [
        "reason"
      ],
      "title": "SourceTimeOverride",
      "type": "object"
    },
    "SyncQaConfig": {
      "additionalProperties": false,
      "description": "Optional clap cross-correlation, as synchronization QA only.\n\nThe spec is explicit that this \"should report disagreement with timecode, not override\nvalid timecode automatically\", so nothing here can move a sample. Off by default: it\ncosts a correlation over two windows per track and answers a question most sessions do\nnot have.\n\nMeasuring near *both* ends is the point. A constant lag is a constant timecode offset;\na lag that *changes* between the start and the end is evidence of sample-clock drift\n(OQ-006), which is the thing the MVP assumes is negligible and never corrects.",
      "properties": {
        "drift_warn_ms": {
          "default": 5,
          "exclusiveMinimum": 0,
          "maximum": 1000,
          "title": "Drift Warn Ms",
          "type": "integer"
        },
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "max_lag_ms": {
          "default": 100,
          "exclusiveMinimum": 0,
          "maximum": 5000,
          "title": "Max Lag Ms",
          "type": "integer"
        },
        "min_correlation": {
          "default": 0.5,
          "exclusiveMinimum": 0.0,
          "maximum": 1.0,
          "title": "Min Correlation",
          "type": "number"
        },
        "offset_warn_ms": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 5000,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Offset Warn Ms"
        },
        "window_s": {
          "default": 30,
          "exclusiveMinimum": 0,
          "maximum": 300,
          "title": "Window S",
          "type": "integer"
        }
      },
      "title": "SyncQaConfig",
      "type": "object"
    },
    "TimecodeConfig": {
      "additionalProperties": false,
      "description": "How to interpret the timecode embedded in the source files.",
      "properties": {
        "bwf_reference_quantum_samples": {
          "default": 1600,
          "maximum": 48000,
          "minimum": 1,
          "title": "Bwf Reference Quantum Samples",
          "type": "integer"
        },
        "chunk_overlap_policy": {
          "default": "reject",
          "enum": [
            "reject",
            "nudge_later"
          ],
          "title": "Chunk Overlap Policy",
          "type": "string"
        },
        "frame_rate": {
          "default": "30F",
          "enum": [
            "23.98F",
            "24F",
            "25F",
            "29.97F",
            "29.97DF",
            "30F",
            "50F",
            "60F"
          ],
          "title": "Frame Rate",
          "type": "string"
        },
        "origin_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Origin Date"
        },
        "origin_timecode": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Origin Timecode"
        },
        "rollover_policy": {
          "default": "infer_forward",
          "enum": [
            "infer_forward",
            "reject"
          ],
          "title": "Rollover Policy",
          "type": "string"
        }
      },
      "title": "TimecodeConfig",
      "type": "object"
    },
    "TrackConfig": {
      "additionalProperties": false,
      "description": "One physical transmitter, and the person wearing it.\n\nThe roster is durable: a track stays configured whether or not its wearer attended.\nPresence is decided by discovery in M1, not by editing this list.",
      "properties": {
        "input": {
          "title": "Input",
          "type": "string"
        },
        "receiver_channel": {
          "maximum": 2,
          "minimum": 1,
          "title": "Receiver Channel",
          "type": "integer"
        },
        "receiver_id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9_-]*$",
          "title": "Receiver Id",
          "type": "string"
        },
        "speaker_id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9_-]*$",
          "title": "Speaker Id",
          "type": "string"
        },
        "speaker_name": {
          "minLength": 1,
          "title": "Speaker Name",
          "type": "string"
        },
        "track_id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9_-]*$",
          "title": "Track Id",
          "type": "string"
        }
      },
      "required": [
        "track_id",
        "receiver_id",
        "receiver_channel",
        "speaker_id",
        "speaker_name",
        "input"
      ],
      "title": "TrackConfig",
      "type": "object"
    },
    "TranscriptConfig": {
      "additionalProperties": false,
      "description": "How activity candidates become ASR requests, and what happens to the answers.\n\nEvery default here is a guess about a model this milestone deliberately does not have.\n**OQ-018** is the record of that, and it is cited from each one so `rg 'OQ-018'` finds\nthem together when M6b can finally measure them.",
      "properties": {
        "duplicate": {
          "$ref": "#/$defs/DuplicateConfig"
        },
        "max_truncation_retries": {
          "default": 4,
          "maximum": 32,
          "minimum": 0,
          "title": "Max Truncation Retries",
          "type": "integer"
        },
        "merge_gap_ms": {
          "default": 1500,
          "maximum": 60000,
          "minimum": 0,
          "title": "Merge Gap Ms",
          "type": "integer"
        },
        "min_split_core_ms": {
          "default": 2000,
          "exclusiveMinimum": 0,
          "maximum": 120000,
          "title": "Min Split Core Ms",
          "type": "integer"
        },
        "overlap_min_ms": {
          "default": 250,
          "maximum": 60000,
          "minimum": 0,
          "title": "Overlap Min Ms",
          "type": "integer"
        },
        "pad_ms": {
          "default": 500,
          "maximum": 10000,
          "minimum": 0,
          "title": "Pad Ms",
          "type": "integer"
        }
      },
      "title": "TranscriptConfig",
      "type": "object"
    },
    "VadConfig": {
      "additionalProperties": false,
      "description": "Where speech starts and stops on one track.\n\nEvery default here is a number chosen against synthetic audio and **OQ-017** is the\nrecord of that: a real session is what will move them.",
      "properties": {
        "merge_gap_ms": {
          "default": 200,
          "maximum": 10000,
          "minimum": 0,
          "title": "Merge Gap Ms",
          "type": "integer"
        },
        "min_silence_ms": {
          "default": 100,
          "maximum": 10000,
          "minimum": 0,
          "title": "Min Silence Ms",
          "type": "integer"
        },
        "min_speech_ms": {
          "default": 250,
          "maximum": 10000,
          "minimum": 0,
          "title": "Min Speech Ms",
          "type": "integer"
        },
        "pad_ms": {
          "default": 30,
          "maximum": 1000,
          "minimum": 0,
          "title": "Pad Ms",
          "type": "integer"
        },
        "silence_threshold": {
          "default": 0.35,
          "exclusiveMaximum": 1.0,
          "exclusiveMinimum": 0.0,
          "title": "Silence Threshold",
          "type": "number"
        },
        "speech_threshold": {
          "default": 0.5,
          "exclusiveMaximum": 1.0,
          "exclusiveMinimum": 0.0,
          "title": "Speech Threshold",
          "type": "number"
        }
      },
      "title": "VadConfig",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A complete, self-describing session.",
  "properties": {
    "active_tracks": {
      "anyOf": [
        {
          "const": "auto",
          "type": "string"
        },
        {
          "items": {
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[a-z0-9][a-z0-9_-]*$",
            "type": "string"
          },
          "type": "array"
        }
      ],
      "default": "auto",
      "title": "Active Tracks"
    },
    "activity": {
      "$ref": "#/$defs/ActivityConfig"
    },
    "asr": {
      "$ref": "#/$defs/AsrConfig"
    },
    "language": {
      "default": "English",
      "minLength": 1,
      "title": "Language",
      "type": "string"
    },
    "mix": {
      "$ref": "#/$defs/MixConfig"
    },
    "recovery": {
      "$ref": "#/$defs/RecoveryConfig"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "session_id": {
      "minLength": 1,
      "title": "Session Id",
      "type": "string"
    },
    "sync_qa": {
      "$ref": "#/$defs/SyncQaConfig"
    },
    "timecode": {
      "$ref": "#/$defs/TimecodeConfig"
    },
    "title": {
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "tracks": {
      "items": {
        "$ref": "#/$defs/TrackConfig"
      },
      "minItems": 1,
      "title": "Tracks",
      "type": "array"
    },
    "transcript": {
      "$ref": "#/$defs/TranscriptConfig"
