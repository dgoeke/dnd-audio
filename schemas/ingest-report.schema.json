{
  "$defs": {
    "Decision": {
      "additionalProperties": false,
      "description": "A choice the pipeline made that a reader may need to audit.\n\nDeterministic by construction: no timings, no counters, nothing that varies between\ntwo identical runs. The spec asks for the report's decision subsection to be\nsemantically stable even though the report as a whole is exempt (INV-02).\n\n``subject`` is what the decision was about — a track id, a source path, a segment\nid — and is what makes two decisions with the same ``code`` orderable.",
      "properties": {
        "code": {
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "detail": {
          "minLength": 1,
          "title": "Detail",
          "type": "string"
        },
        "details": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Details",
          "type": "object"
        },
        "subject": {
          "minLength": 1,
          "title": "Subject",
          "type": "string"
        }
      },
      "required": [
        "code",
        "subject",
        "detail"
      ],
      "title": "Decision",
      "type": "object"
    },
    "Deliverable": {
      "additionalProperties": false,
      "description": "A file this run produced, and its hash.",
      "properties": {
        "relative_path": {
          "title": "Relative Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "relative_path",
        "sha256",
        "size_bytes"
      ],
      "title": "Deliverable",
      "type": "object"
    },
    "OverallStatus": {
      "enum": [
        "complete",
        "partial",
        "failed"
      ],
      "title": "OverallStatus",
      "type": "string"
    },
    "Provenance": {
      "additionalProperties": false,
      "description": "Deterministic facts about the inputs and the software.\n\nINV-03: nothing in here may vary between two identical runs. No timestamps, no\ndurations, no cache counters, no hostname. Those live in :class:`Telemetry`, and\n``tests/test_report.py`` asserts that no field here is time-typed.",
      "properties": {
        "commands": {
          "items": {
            "type": "string"
          },
          "title": "Commands",
          "type": "array"
        },
        "config_hash": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Config Hash"
        },
        "deliverables": {
          "items": {
            "$ref": "#/$defs/Deliverable"
          },
          "title": "Deliverables",
          "type": "array"
        },
        "model_identity": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Model Identity",
          "type": "object"
        },
        "package_versions": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Package Versions",
          "type": "object"
        },
        "runtime": {
          "anyOf": [
            {
              "$ref": "#/$defs/RuntimeProvenance"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "tool_versions": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Tool Versions",
          "type": "object"
        }
      },
      "title": "Provenance",
      "type": "object"
    },
    "ReportWarning": {
      "additionalProperties": false,
      "description": "Something the operator should look at that did not stop the run.",
      "properties": {
        "code": {
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "details": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Details",
          "type": "object"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "ReportWarning",
      "type": "object"
    },
    "RosterSummary": {
      "additionalProperties": false,
      "description": "Who was configured, who was recording, and what was found where.",
      "properties": {
        "active_tracks": {
          "items": {
            "type": "string"
          },
          "title": "Active Tracks",
          "type": "array"
        },
        "empty_directories": {
          "items": {
            "type": "string"
          },
          "title": "Empty Directories",
          "type": "array"
        },
        "extra_directories": {
          "items": {
            "type": "string"
          },
          "title": "Extra Directories",
          "type": "array"
        },
        "file_counts": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "File Counts",
          "type": "object"
        },
        "inactive_tracks": {
          "items": {
            "type": "string"
          },
          "title": "Inactive Tracks",
          "type": "array"
        },
        "known_tracks": {
          "items": {
            "type": "string"
          },
          "title": "Known Tracks",
          "type": "array"
        },
        "missing_directories": {
          "items": {
            "type": "string"
          },
          "title": "Missing Directories",
          "type": "array"
        }
      },
      "title": "RosterSummary",
      "type": "object"
    },
    "RuntimeProvenance": {
      "additionalProperties": false,
      "description": "The compute runtime a stage resolved: which device, which precision, which build.\n\nPresent only on a run that actually resolved one. That is deliberate rather than\ndefensive: ``inspect``, ``ingest``, ``activity`` and ``mix`` never load Torch, so\nfilling this in for them would mean probing a GPU those stages have no use for, and\nrecording an answer no stage acted on. An absent section says \"nothing here chose a\ndevice\", which is true and is not the same as \"there is no GPU\".\n\nEvery field reaches an ASR cache key (INV-08): the same audio transcribed in BF16 on\ngfx1151 and in float32 on a CPU are not the same result, and a Torch or HIP upgrade\ncan change a kernel's rounding. Defining them here once means M6b adds them to\n``TranscriberIdentity`` without a second vocabulary to drift from this one.",
      "properties": {
        "attention": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Attention"
        },
        "device": {
          "title": "Device",
          "type": "string"
        },
        "device_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Device Name"
        },
        "dtype": {
          "title": "Dtype",
          "type": "string"
        },
        "hip": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Hip"
        },
        "python": {
          "title": "Python",
          "type": "string"
        },
        "torch": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Torch"
        }
      },
      "required": [
        "python",
        "device",
        "dtype"
      ],
      "title": "RuntimeProvenance",
      "type": "object"
    },
    "StageName": {
      "description": "The executable stage DAG, in dependency order.\n\nDeclaration order is the serialization order — see :data:`STAGE_ORDER`. Report\nfinalization is not here: it is an always-run internal sink, not a stage that can\nitself be skipped.",
      "enum": [
        "inspect",
        "reconstruct",
        "activity",
        "transcribe",
        "render",
        "mix"
      ],
      "title": "StageName",
      "type": "string"
    },
    "StageOrigin": {
      "description": "Whether a completed stage did its work or was served from cache.\n\nSeparate from :class:`StageStatus` because they answer different questions. A stage\nserved entirely from cache genuinely *completed* — its outputs are current and its\ndeliverables are real — so calling it `skipped` would be false, and a caller checking\nwhether the manifest reflects the sources on disk would read the wrong answer.",
      "enum": [
        "executed",
        "reused"
      ],
      "title": "StageOrigin",
      "type": "string"
    },
    "StageReport": {
      "additionalProperties": false,
      "description": "One stage's outcome.",
      "properties": {
        "errors": {
          "items": {
            "$ref": "#/$defs/StructuredError"
          },
          "title": "Errors",
          "type": "array"
        },
        "origin": {
          "anyOf": [
            {
              "$ref": "#/$defs/StageOrigin"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "skip_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Skip Reason"
        },
        "stage": {
          "$ref": "#/$defs/StageName"
        },
        "status": {
          "$ref": "#/$defs/StageStatus"
        },
        "warnings": {
          "items": {
            "$ref": "#/$defs/ReportWarning"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "stage",
        "status"
      ],
      "title": "StageReport",
      "type": "object"
    },
    "StageStatus": {
      "enum": [
        "complete",
        "failed",
        "skipped"
      ],
      "title": "StageStatus",
      "type": "string"
    },
    "StructuredError": {
      "additionalProperties": false,
      "description": "A failure a caller can branch on without parsing prose.",
      "properties": {
        "code": {
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "details": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Details",
          "type": "object"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "StructuredError",
      "type": "object"
    },
    "Telemetry": {
      "additionalProperties": false,
      "description": "Per-run measurements. Legitimately different every time.\n\nThe report as a whole is exempt from byte-stability precisely because of this\nsection; its provenance and decisions must still be semantically stable (INV-02).",
      "properties": {
        "cache_hits": {
          "default": 0,
          "minimum": 0,
          "title": "Cache Hits",
          "type": "integer"
        },
        "cache_misses": {
          "default": 0,
          "minimum": 0,
          "title": "Cache Misses",
          "type": "integer"
        },
        "finished_at": {
          "format": "date-time",
          "title": "Finished At",
          "type": "string"
        },
        "stage_seconds": {
          "additionalProperties": {
            "type": "number"
          },
          "propertyNames": {
            "$ref": "#/$defs/StageName"
          },
          "title": "Stage Seconds",
          "type": "object"
        },
        "started_at": {
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        }
      },
      "required": [
        "started_at",
        "finished_at"
      ],
      "title": "Telemetry",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The structured record of one run.",
  "properties": {
    "decisions": {
      "items": {
        "$ref": "#/$defs/Decision"
      },
      "title": "Decisions",
      "type": "array"
    },
    "overall_status": {
      "$ref": "#/$defs/OverallStatus"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "roster": {
      "anyOf": [
        {
          "$ref": "#/$defs/RosterSummary"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "session_id": {
      "title": "Session Id",
      "type": "string"
    },
    "stages": {
      "items": {
        "$ref": "#/$defs/StageReport"
      },
      "title": "Stages",
      "type": "array"
    },
    "telemetry": {
      "$ref": "#/$defs/Telemetry"
    }
  },
  "required": [
    "session_id",
    "overall_status",
    "stages",
    "provenance",
    "telemetry"
  ],
  "title": "IngestReport",
  "type": "object"
}
