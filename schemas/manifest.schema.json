{
  "$defs": {
    "ManifestSource": {
      "additionalProperties": false,
      "description": "One source file as it was found. Never modified — INV-01.",
      "properties": {
        "relative_path": {
          "title": "Relative Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "relative_path",
        "sha256",
        "size_bytes"
      ],
      "title": "ManifestSource",
      "type": "object"
    },
    "ManifestTrack": {
      "additionalProperties": false,
      "description": "One roster track, and whichever originals were discovered for it.",
      "properties": {
        "active": {
          "title": "Active",
          "type": "boolean"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/ManifestSource"
          },
          "title": "Sources",
          "type": "array"
        },
        "speaker_id": {
          "title": "Speaker Id",
          "type": "string"
        },
        "track_id": {
          "title": "Track Id",
          "type": "string"
        }
      },
      "required": [
        "track_id",
        "speaker_id",
        "active"
      ],
      "title": "ManifestTrack",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The deterministic inventory `inspect` writes to ``work/manifest.json``.",
  "properties": {
    "config_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Config Hash",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "session_id": {
      "title": "Session Id",
      "type": "string"
    },
    "tracks": {
      "items": {
        "$ref": "#/$defs/ManifestTrack"
      },
      "title": "Tracks",
      "type": "array"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "session_id",
    "config_hash"
  ],
  "title": "Manifest",
  "type": "object"
}
