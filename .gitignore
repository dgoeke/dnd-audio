# Never commit session material or model artifacts.
**/raw/
**/work/
**/output/
*.wav
*.mp3
*.flac
*.m4a
models/
.hf-cache/
*.safetensors
*.ckpt
*.pt
*.onnx

# Secrets
.env
.env.*
*token*
!**/*token*.py

# Archive credentials (M7a). The operator profile belongs outside this repository
# entirely — `~/.config/dnd-audio/archive.yaml` is the suggested home — but this
# repository is public and a Spaces secret key committed here is unrecoverable, so the
# obvious filenames are ignored as a second line of defence rather than trusted not to
# appear. See ADR-0035.
archive.yaml
archive.yml
archive-profile*
*.credentials
credentials

# Python
__pycache__/
*.py[cod]
# `.venv` is the project environment; `.venv-rocm` is the opt-in ROCm one the
# `asr-qwen` group installs into, kept separate so the everyday gate keeps running the
# group-absent case rather than proving it once (ADR-0025).
.venv*/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
dist/
build/
*.egg-info/

# Nix / direnv
result
result-*
.direnv/

# Operator-local notes: host, user, and absolute paths that must not reach a
# public repository. Committed docs refer to it but never quote it.
LOCAL.md

# Raw reviewer transcripts. scripts/codex-review.sh saves the reviewer's whole
# session, which quotes every file it read — LOCAL.md included. The distilled
# review beside it (without the .raw) is what gets committed.
docs/plan/reviews/*.raw.md

# Scratch
.scratch/
